<resources>
    <!-- Полноэкранный режим: системный статус-бар скрыт полностью. -->
    <style name="Theme.voidtrack" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
        <item name="android:statusBarColor">#080A0B</item>
        <item name="android:navigationBarColor">#080A0B</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:fitsSystemWindows">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
